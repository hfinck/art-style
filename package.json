{
  "name": "art-style-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "ci": "npm run check:boundaries && npm run typecheck && npm test && vite build"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "typescript": "~5.9",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
